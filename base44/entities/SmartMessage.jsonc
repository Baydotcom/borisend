{
  "name": "SmartMessage",
  "type": "object",
  "properties": {
    "owner_user_id": {
      "type": "string",
      "description": "Authoritative owner \u2014 the user who created this Smart Message. Set server-side, never trusted from the client."
    },
    "name": {
      "type": "string",
      "description": "User-facing label (e.g. 'Arrived at Work', 'Good Morning Love')."
    },
    "description": {
      "type": "string",
      "description": "Optional user-facing description/notes about this Smart Message."
    },
    "content": {
      "type": "string",
      "description": "RC18 \u00a716/\u00a717: FIXED, user-authored message text. This is NEVER generated by an LLM. The intelligence of a Smart Message comes from WHEN it is triggered, not from generating new wording. No generation pipeline (generateMessage, InvokeLLM, prompt-builder, MessageSpecification) is invoked during execution."
    },
    "trigger_type": {
      "type": "string",
      "enum": [
        "time",
        "date",
        "recurring_date",
        "manual_event",
        "location_arrival",
        "location_departure"
      ],
      "description": "RC18 \u00a720: Clean trigger definitions for Smart Messages. Distinct from Communication Plan trigger_type. Smart Messages use their own taxonomy to maintain architectural separation (\u00a718)."
    },
    "trigger_config": {
      "type": "object",
      "properties": {
        "time_of_day": {
          "type": "string",
          "description": "For time/recurring_date/date triggers: HH:MM format (24h)."
        },
        "specific_date": {
          "type": "string",
          "format": "date",
          "description": "For date trigger: the specific date."
        },
        "recurring_days": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "For recurring_date trigger: 0=Sun, 1=Mon, ..., 6=Sat. Empty array = every day."
        },
        "recurring_pattern": {
          "type": "string",
          "enum": [
            "weekly",
            "monthly",
            "annual"
          ],
          "description": "For recurring_date trigger: weekly = selected weekdays, monthly = specific day of month, annual = specific month+day each year."
        },
        "recurring_month": {
          "type": "number",
          "description": "For annual recurring_pattern: month 1-12."
        },
        "recurring_day_of_month": {
          "type": "number",
          "description": "For monthly/annual recurring_pattern: day of month 1-31."
        },
        "manual_event_label": {
          "type": "string",
          "description": "For manual_event trigger: user-facing label (e.g. 'I've arrived safely')."
        },
        "location_place_name": {
          "type": "string",
          "description": "RC18 \u00a721: Human-readable place name (e.g. 'Work', 'Home')."
        },
        "location_address": {
          "type": "string",
          "description": "Full street address for the location."
        },
        "location_postcode": {
          "type": "string",
          "description": "Postcode/ZIP for the location."
        },
        "location_latitude": {
          "type": "number",
          "description": "RC20: Geofence centre latitude. Canonical coordinate \u2014 required for location triggers. Captured at config time (manual entry or current-location), not continuously polled."
        },
        "location_longitude": {
          "type": "number",
          "description": "RC20: Geofence centre longitude. Canonical coordinate \u2014 required for location triggers."
        },
        "location_radius_meters": {
          "type": "number",
          "description": "RC20: Geofence radius in metres. Validated 50\u20131000. Default 200m."
        },
        "geofence_id": {
          "type": "string",
          "description": "RC20: Deterministic geofence identifier used to validate incoming native transition events. Expected value: 'borisend_sm_{smart_message_id}'. Set server-side; the native layer registers with this id and the backend verifies it in processGeofenceEvent."
        },
        "geofence_registered": {
          "type": "boolean",
          "default": false,
          "description": "RC20: Whether the native geofence is currently registered on the device. Managed by GeofenceService during reconcile. False until native plugin is available and registration succeeds."
        },
        "trigger_cooldown_minutes": {
          "type": "number",
          "default": 30,
          "description": "RC20: Minimum minutes between geofence trigger firings. Prevents boundary oscillation (a phone oscillating around the radius) from consuming Smart Message Units. Default 30 minutes. The backend enforces this via last_triggered_at in processGeofenceEvent."
        }
      },
      "description": "RC18 \u00a720/\u00a721 + RC20: Trigger-specific configuration. Structure depends on trigger_type. Only relevant fields are populated per trigger type. Location triggers carry canonical coordinates + geofence_id + cooldown."
    },
    "message_language": {
      "type": "string",
      "description": "Optional: MessageLanguage system_key for display/grouping. Smart Message content is always fixed user-authored text \u2014 this is metadata, not a generation parameter."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "inactive",
      "description": "RC18: Smart Messages default to inactive. User must explicitly activate before any execution can occur."
    },
    "last_triggered_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this Smart Message was last executed. Used by processGeofenceEvent for cooldown enforcement. Null if never triggered."
    },
    "next_trigger_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the next trigger is deterministically expected to fire. Null for manual_event and location triggers (non-deterministic), or if not yet calculated."
    },
    "last_execution_status": {
      "type": "string",
      "enum": [
        "success",
        "blocked",
        "failed",
        "partial"
      ],
      "description": "Result of the most recent execution attempt. success = all recipients executed, blocked = capacity exhausted, failed = technical error, partial = some recipients succeeded but not all."
    }
  },
  "required": [
    "owner_user_id",
    "name",
    "content",
    "trigger_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.owner_user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}