{
  "name": "RelationshipType",
  "type": "object",
  "properties": {
    "system_key": {
      "type": "string",
      "description": "Stable system key (e.g. husband_to_wife). Never changes."
    },
    "category_id": {
      "type": "string",
      "description": "RelationshipCategory entity ID"
    },
    "category_system_key": {
      "type": "string",
      "description": "Denormalized category system key for portable lookups without a join."
    },
    "display_label": {
      "type": "string",
      "description": "Human-readable label (e.g. Husband \u2192 Wife)"
    },
    "user_role_label": {
      "type": "string",
      "description": "Label for the owner's role in this relationship"
    },
    "recipient_role_label": {
      "type": "string",
      "description": "Label for the recipient's role"
    },
    "description": {
      "type": "string"
    },
    "direction_sensitive": {
      "type": "boolean",
      "default": true,
      "description": "True when the relationship has a direction (husband_to_wife). False for symmetric (friend_to_friend)."
    },
    "display_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "system_key",
    "category_id",
    "display_label"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}