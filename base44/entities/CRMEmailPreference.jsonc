{
  "name": "CRMEmailPreference",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "service_email_enabled": {
      "type": "boolean",
      "default": true
    },
    "marketing_email_enabled": {
      "type": "boolean",
      "default": true
    },
    "marketing_opted_out_at": {
      "type": "string",
      "format": "date-time"
    },
    "marketing_opted_in_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}