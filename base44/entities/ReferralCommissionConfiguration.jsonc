{
  "name": "ReferralCommissionConfiguration",
  "type": "object",
  "properties": {
    "commission_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Master switch for recurring commission rewards"
    },
    "commission_type": {
      "type": "string",
      "enum": [
        "percentage",
        "fixed_amount"
      ],
      "default": "percentage",
      "description": "Whether commission is a percentage of payment or a fixed amount per cycle"
    },
    "commission_percentage": {
      "type": "number",
      "description": "Percentage rate (e.g. 10 for 10%). Used when commission_type is percentage."
    },
    "commission_fixed_amount": {
      "type": "number",
      "description": "Fixed amount per billing cycle. Used when commission_type is fixed_amount."
    },
    "duration_type": {
      "type": "string",
      "enum": [
        "fixed_months",
        "lifetime"
      ],
      "default": "fixed_months",
      "description": "fixed_months = expires after N billing cycles; lifetime = continues while eligible"
    },
    "duration_months": {
      "type": "number",
      "default": 12,
      "description": "Number of paid billing cycles before commission expires (fixed_months only). e.g. 24 = 24 monthly payments or 2 yearly payments."
    },
    "eligible_billing_periods": {
      "type": "string",
      "enum": [
        "monthly",
        "yearly",
        "both"
      ],
      "default": "both",
      "description": "Which billing periods are eligible for commission"
    },
    "require_active_subscription": {
      "type": "boolean",
      "default": true,
      "description": "If true, referred user must have an active paid subscription for commission to apply"
    },
    "commission_starts_after": {
      "type": "string",
      "enum": [
        "first_payment",
        "trial_end",
        "subscription_activation"
      ],
      "default": "first_payment",
      "description": "When commission begins: first_payment = first invoice paid; trial_end = first renewal after trial; subscription_activation = same as first_payment"
    },
    "max_commission_cap": {
      "type": "number",
      "description": "Optional maximum total commission amount per referred user. null/undefined = no cap."
    },
    "minimum_payment_threshold": {
      "type": "number",
      "description": "Optional minimum payment amount required to trigger commission. null/undefined = no minimum."
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "updated_by": {
      "type": "string",
      "description": "Admin user ID who last updated this configuration"
    }
  },
  "required": [],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}