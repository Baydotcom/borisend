{
  "name": "MessageFeedback",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "campaign_id": {
      "type": "string"
    },
    "message_id": {
      "type": "string"
    },
    "generation_key": {
      "type": "string"
    },
    "rating": {
      "type": "string",
      "enum": [
        "love_it",
        "its_okay",
        "prepare_another"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "too_formal",
          "too_casual",
          "too_romantic",
          "not_warm_enough",
          "too_long",
          "too_short",
          "did_not_sound_natural",
          "did_not_sound_like_me",
          "did_not_fit_occasion",
          "wrong_humour_level",
          "wrong_emoji_usage",
          "other"
        ]
      }
    },
    "custom_reason": {
      "type": "string"
    },
    "improvement_action": {
      "type": "string",
      "description": "Guided improvement action if requested"
    },
    "recipient_id": {
      "type": "string"
    },
    "version_number": {
      "type": "number"
    }
  },
  "required": [
    "user_id",
    "campaign_id",
    "message_id",
    "rating"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}