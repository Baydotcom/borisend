{
  "name": "CRMConversation",
  "type": "object",
  "properties": {
    "owner_user_id": {
      "type": "string",
      "description": "User who opened the conversation."
    },
    "user_email": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "waiting_on_user",
        "waiting_on_team",
        "resolved"
      ],
      "default": "open"
    },
    "priority": {
      "type": "string",
      "enum": [
        "normal",
        "high"
      ],
      "default": "normal"
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_message_preview": {
      "type": "string"
    },
    "unread_by_user": {
      "type": "number",
      "default": 0
    },
    "unread_by_admin": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "owner_user_id",
    "subject"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.owner_user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}