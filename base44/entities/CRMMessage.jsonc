{
  "name": "CRMMessage",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string",
      "description": "Owner of the parent conversation; retained for RLS."
    },
    "sender_type": {
      "type": "string",
      "enum": [
        "user",
        "admin",
        "system"
      ]
    },
    "sender_user_id": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "sender_email": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "is_read_by_user": {
      "type": "boolean",
      "default": false
    },
    "is_read_by_admin": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "conversation_id",
    "owner_user_id",
    "sender_type",
    "body"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.owner_user_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}