{
  "name": "RelationshipCategory",
  "type": "object",
  "properties": {
    "system_key": {
      "type": "string",
      "description": "Stable system key \u2014 never changes even if display_name changes. Used as the portable identifier."
    },
    "display_name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "display_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "system_key",
    "display_name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}