{
  "name": "CRMEmailCampaign",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "audience_type": {
      "type": "string",
      "enum": [
        "all_users",
        "selected_users"
      ],
      "default": "selected_users"
    },
    "recipient_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sending",
        "sent",
        "failed"
      ],
      "default": "draft"
    },
    "sent_count": {
      "type": "number",
      "default": 0
    },
    "failed_count": {
      "type": "number",
      "default": 0
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by_user_id": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "subject",
    "body"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}